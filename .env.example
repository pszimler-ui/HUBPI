OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
# GitHub Models (fine-grained PAT, "Models: read" jogosultsággal)
GITHUB_TOKEN=github_pat_...
PERPLEXITY_API_KEY=pplx-...
# Opcionális – korlátozott hozzáférés. Kulcs nélkül a DeepSeek nem is jelenik meg.
# DEEPSEEK_API_KEY=...

# Opcionális modell-felülírások
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-2.5-flash
# GITHUB_MODELS_MODEL=openai/gpt-4o
# PERPLEXITY_MODEL=sonar
# DEEPSEEK_MODEL=deepseek-chat

# ---------- Védelem ----------
# Ha megadod, minden oldal jelszót kér (felhasználónév: HUB_USER, alapból admin).
# Hálózaton / interneten KÖTELEZŐ, és ott csak HTTPS mögött használd.
# HUB_USER=admin
# HUB_PASSWORD=valami-hosszu-veletlen-jelszo
# Fizetős kérések (chat / multi) száma percenként, IP-címenként
# HUB_RATE_LIMIT=20
